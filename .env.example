# ── Database ──────────────────────────────────────────────
# Free Postgres: create a database at https://neon.tech (or Supabase)
# and paste the pooled connection string here.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# ── Auth ──────────────────────────────────────────────────
# Any long random string. Generate one with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-long-random-string"

# ── Cloudinary (product images) ───────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── App URL (used to build password-reset links) ──────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
